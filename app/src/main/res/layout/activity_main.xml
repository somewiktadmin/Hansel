<?xml version="1.0" encoding="utf-8"?>
<!-- Hansel v0.987 - main layout
     MapView (OSMDroid) takes 60% of screen height via weight 3.
     WebView takes 40% for controls, graph, and scrollbox via weight 2.
     FrameLayout wrapper allows native views to float over the map. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Map area: OSMDroid + floating controls stacked in a FrameLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- gpsInfoOverlay - GPS info lines, below paused floaties.
                     Line 0: Hansel v0.987 [spaces] zoomerLine (right justified)
                     Line 1: mostCurrentGPS (timestamp first, lat, lon, alt, spd)
        -->
        <TextView
            android:id="@+id/gpsInfoOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="30dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="0dp"
            android:layout_marginEnd="6dp"
            android:textColor="#FFFFFFFF"
            android:background="#4F000000"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="Hansel v0.987" />

        <!-- skyBarBox - sky timeline, below gpsInfoOverlay.
               Line 0:    12    16    20    00    04    08    12  (header)
             Lines 1+: DD|<36-char sky bar>, grows upward during replay.
             android:background="#4F000000"   for layout testing only
        -->
        <TextView
            android:id="@+id/skyBarBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginTop="120dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginEnd="6dp"
            android:background="#4F000000"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:typeface="monospace"
            android:text="   12    16    20    00    04    08    12" />

        <!-- Paused floaties - top center, side by side.
             LIVE UPDATES PAUSED: visible when liveFollowMode=false.
             REPLAY PAUSED: visible when replayInProgress and replayFollowMode=false.
             Both can appear simultaneously when map is panned during replay. -->
        <LinearLayout
            android:id="@+id/pausedFloatieRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/liveUpdatesPausedFloatie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="[ HISTORY REPLAYING ]"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="4dp"
                android:background="#CC000000"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />

            <!-- This button only visible, when previous button is already visible.-->
            <TextView
                android:id="@+id/replayPausedFloatie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text=" - [ REPLAY PAUSED ]"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#CC000000"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Right-edge control column: location buttons above zoom controls
            android:gravity="center_horizontal"
         -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <!-- [ME] - snap to current GPS position -->
            <Button
                android:id="@+id/btnMe"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="me"
                android:textSize="11sp" />

            <!-- [HMM] - Near Halemaumau - center-ish of crater 19.411, -155.269 -->
            <Button
                android:id="@+id/btnHMM"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="HMM"
                android:textSize="9sp" />

            <!-- [+] zoom in -->
            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="14sp" />

            <!-- Vertical zoom slider - thumb travels bottom to top = low to high zoom - - >
            <SeekBar
                android:id="@+id/zoomSlider"
                android:layout_width="48dp"
                android:layout_height="100dp"
                android:max="19"
                android:progress="12"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />
                -->

            <!-- [-] zoom out -->
            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- WebView: controls, graph, scrollbox - bottom 40% -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

</LinearLayout>