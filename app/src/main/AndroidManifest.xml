<?xml version="1.0" encoding="utf-8"?>
<!--
    Hansel - GPS breadcrumb logger - v0.987
    Copyright (C) 2026 GrimmsTales
    GNU General Public License v3 - https://www.gnu.org/licenses/gpl-3.0.html

    Permissions notes:

    READ_EXTERNAL_STORAGE: redundant on SDK 30+ where MANAGE_EXTERNAL_STORAGE
    supersedes it.  Retained for minSdk 21 compatibility.

    MANAGE_EXTERNAL_STORAGE: required on SDK 30+ for direct File access
    bypassing SAF.  This is the permission that makes getFileList() and
    readFile() work without DocumentFile gymnastics.  Google Play requires
    justification for this permission - it will need a declaration in the
    Play Console before any store submission.

    ACCESS_BACKGROUND_LOCATION: required on SDK 29+ for location updates
    while the app is not in the foreground.  Also requires Play Console
    justification for store submission.

    FOREGROUND_SERVICE_LOCATION: required on SDK 34+ in addition to
    FOREGROUND_SERVICE.  Both are needed or the system will not deliver
    location updates to a foreground service.

    foregroundServiceType="location" on the LocationService declaration
    is the manifest companion to the FOREGROUND_SERVICE_LOCATION permission.
    Both must be present - neither alone is sufficient on SDK 34+.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hansel.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"  />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Hansel-v0.987"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hansel">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".LocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>


    </application>

</manifest>